{
  "expo": {
    "name": "Chunchi City App",
    "slug": "chunchi-city-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/chunchi-city-images/icon.png",
    "scheme": "chunchicity",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ferx666g.chunchicity",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/chunchi-city-images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMobileAds": {
          "androidAppId": "ca-app-pub-7868058661453955~5852649017"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/chunchi-city-images/favicon.png"
    },
    "extra": {
      "react-native-google-mobile-ads": {
        "androidAppId": "ca-app-pub-7868058661453955~5852649017",
        "iosAppId": "ca-app-pub-7868058661453955~5852649017"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/chunchi-city-images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "react-native-compressor",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-av",
        {
          "microphonePermission": "Permite que Chunchi City use el micrófono para grabar mensajes de voz."
        }
      ],
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7868058661453955~5852649017",
          "iosAppId": "ca-app-pub-7868058661453955~5852649017"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-7868058661453955~5852649017",
    "ios_app_id": "ca-app-pub-7868058661453955~5852649017"
  }
}
